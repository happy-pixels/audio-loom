{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./examples/dist",
    "rootDir": "./src",
    
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "rewriteRelativeImportExtensions": true,
    
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}